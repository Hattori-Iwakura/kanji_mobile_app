# API Configuration
# Use localhost for web/desktop, 10.0.2.2 for Android emulator
# Note: Do NOT include /api suffix - it will be added by ApiEndpoints
API_BASE_URL=http://10.0.2.2:3000
API_TIMEOUT=30000

# AI Model Configuration
AI_MODEL_URL=http://127.0.0.1:8000

# Feature Flags
ENABLE_DEBUG_MODE=true
ENABLE_ANALYTICS=false

# App Configuration
APP_NAME=Kanji Learning App
APP_VERSION=1.0.0
